# Release profile: test-server-mainnet-checkin
# 测试服务器 · BSC 主网 CheckIn（复用已部署 proxy）· project 链保持测试网 97 只读
#
# 该 profile 是唯一允许的测试服务器发布口径：
#   - 应用运行环境 = 测试服务器；CheckIn 网络 = BSC 主网 —— 两者独立表达，禁止混用
#   - CheckIn proxy 复用 0xE029161be55922edf3eC9D222142edf057d196ee，绝不重新部署
#   - Hardhat / 本地链配置禁止进入有效构建
#   - Launchpad/IDO 项目链为 97（测试网），仅声明为受信项目链；IDO job 不启用
# 注意：VITE_REOWN_PROJECT_ID 不在本文件 —— 它必须由构建者显式 export，
#       构建脚本绝不读取 .deploy.env（生产配置不得渗入测试服务器发布）。

RELEASE_PROFILE="test-server-mainnet-checkin"
RELEASE_PROFILE_KIND="checkin"
RELEASE_DESCRIPTION="test server / BSC mainnet CheckIn with existing proxy / project chain 97 read-only"

VITE_ENVIRONMENT=prod
VITE_CHECKIN_CHAIN_ID=56
VITE_CHECKIN_CHAIN_NAME="BNB Smart Chain"
VITE_CHECKIN_CURRENCY=BNB
VITE_HARDHAT_RPC=
VITE_CHECKIN_ADDRESS="0xE029161be55922edf3eC9D222142edf057d196ee"
VITE_TRUSTED_PROJECT_CHAINS="97"

# API 同源（前端 nginx 反代 /client/* → backend）；跨域部署才显式设置
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
