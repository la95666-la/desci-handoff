{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joincare.example/schemas/fair-launch/key-set.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "keySetVersion",
    "threshold",
    "keys",
    "validFromGeneration",
    "validThroughGeneration",
    "supersedesKeySetVersion",
    "previousKeySetDigest",
    "revokedAtGeneration",
    "revocationReason",
    "issuedAt",
    "signaturesByPreviousKeySet"
  ],
  "properties": {
    "domain": {
      "const": "joincare.release.key-set.v1"
    },
    "keySetVersion": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "threshold": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3
    },
    "keys": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "publicKeyBase64"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "publicKeyBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        }
      }
    },
    "validFromGeneration": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "validThroughGeneration": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "supersedesKeySetVersion": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "previousKeySetDigest": {
      "$ref": "common.schema.json#/$defs/nullableDigest"
    },
    "revokedAtGeneration": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "revocationReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signaturesByPreviousKeySet": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "signatureBase64"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "signatureBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      }
    }
  }
}
