{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joincare.example/schemas/fair-launch/signature-envelope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "payloadDomain",
    "payloadSha256",
    "keySetVersion",
    "signatures"
  ],
  "properties": {
    "domain": {
      "const": "joincare.release.detached-signature-envelope.v1"
    },
    "payloadDomain": {
      "enum": [
        "joincare.release.image-capability.v1",
        "joincare.release.environment-bootstrap.v1",
        "joincare.release.key-set.v1",
        "joincare.release.key-revocation.v1",
        "joincare.release.fair-launch-watermark.v1",
        "joincare.release.deployment-attestation.v1",
        "joincare.restore-recovery-attestation.v1"
      ]
    },
    "payloadSha256": {
      "$ref": "common.schema.json#/$defs/digest256"
    },
    "keySetVersion": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "signatureBase64"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "signatureBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      }
    }
  }
}
