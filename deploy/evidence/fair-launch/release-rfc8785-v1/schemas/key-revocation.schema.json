{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joincare.example/schemas/fair-launch/key-revocation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "keySetVersion",
    "revokedKeyIds",
    "effectiveGeneration",
    "reason",
    "issuedAt",
    "previousRevocationDigest"
  ],
  "properties": {
    "domain": {
      "const": "joincare.release.key-revocation.v1"
    },
    "keySetVersion": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "revokedKeyIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,32}$"
      }
    },
    "effectiveGeneration": {
      "$ref": "common.schema.json#/$defs/positiveUint"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "previousRevocationDigest": {
      "$ref": "common.schema.json#/$defs/nullableDigest"
    }
  }
}
