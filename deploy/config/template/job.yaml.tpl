# Auto-generated by ./deploy.sh · independent chain event/lifecycle job service
application:
  name: job
  environment: ${JC_ENV}

protocol:
  http:
    host: ""
    port: 13007

chainEvent:
  # 同一事件连续失败达到该次数后进入 dead-letter，仍阻断游标，需 Admin replay。
  maxRetries: ${JC_CHAIN_EVENT_MAX_RETRIES}
  # 安全链尖落后超过该区块数时 health 返回 503。
  maxHealthyLagBlocks: ${JC_CHAIN_EVENT_MAX_HEALTHY_LAG_BLOCKS}

# Code paths may exist, but listener/writer/signer remain disabled until the
# signed deployment attestation, source registry and watermark gates pass.
fairLaunchV1:
  enabled: ${JC_FAIR_LAUNCH_ENABLED_YAML}
  writesEnabled: ${JC_FAIR_LAUNCH_WRITES_ENABLED_YAML}
  migrationsEnabled: ${JC_FAIR_LAUNCH_MIGRATIONS_ENABLED_YAML}
  chainId: ${JC_FAIR_LAUNCH_CHAIN_ID}
  proxyAddress: "${JC_FAIR_LAUNCH_PROXY_ADDRESS}"
  startBlock: ${JC_FAIR_LAUNCH_START_BLOCK}
  sourceRegistryRevision: "${JC_FAIR_LAUNCH_SOURCE_REGISTRY_REVISION}"
  sourceRegistryDigest: "${JC_FAIR_LAUNCH_SOURCE_REGISTRY_DIGEST}"
  deploymentAttestationDigest: "${JC_FAIR_LAUNCH_DEPLOYMENT_ATTESTATION_DIGEST}"
  capabilityManifestDigest: "${JC_FAIR_LAUNCH_CAPABILITY_MANIFEST_DIGEST}"
  watermarkGeneration: ${JC_FAIR_LAUNCH_WATERMARK_GENERATION}
  signPolicyGatewayURL: "${JC_FAIR_LAUNCH_SIGN_POLICY_GATEWAY_URL}"
  web3SignerURL: "${JC_FAIR_LAUNCH_WEB3SIGNER_URL}"
