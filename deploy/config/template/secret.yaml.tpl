# Auto-generated by ./deploy.sh · secret 层 (env-specific 敏感凭据)
# 请勿手动编辑 —— 用 ./deploy.sh config <section> 更新

# Legacy Core/Job still share one DB pool. Fair Launch activation is mechanically
# unavailable until separate reviewed runtime/Admin/Job/ingestion pools are wired.
# A single JC_MYSQL_USER must never be treated as satisfying the Fair Launch policy.
db:
  mysql:
    host: ${JC_MYSQL_HOST}:${JC_MYSQL_PORT}
    user: ${JC_MYSQL_USER}
    password: "${JC_MYSQL_PASSWORD}"
    databaseName: ${JC_MYSQL_DB}
    readHost: ${JC_MYSQL_HOST}:${JC_MYSQL_PORT}
    readUser: ${JC_MYSQL_USER}
    readPassword: "${JC_MYSQL_PASSWORD}"
  redis:
    # go-redis Cluster 客户端 → host 数组，含 host:port；内嵌 redis 跑在 7000 无密码
    host:
      - redis:7000
    password: "${JC_REDIS_PASSWORD}"

# JWT 签名密钥 —— 轮换即全部用户登出
jwt:
  secret: "${JC_JWT_SECRET}"
admin:
  jwtSecret: "${JC_ADMIN_JWT_SECRET}"

# Lark 多维表格（项目申请/审核/TGE 镜像）+ 运维告警 webhook
lark:
  opsWebhook: ${JC_LARK_OPS_WEBHOOK}
  reviewHall:
    appID: ${JC_LARK_REVIEW_APP_ID}
    appSecret: ${JC_LARK_REVIEW_APP_SECRET}
    appToken: ${JC_LARK_REVIEW_APP_TOKEN}
    tableID: ${JC_LARK_REVIEW_TABLE_ID}
  applyHall:
    appID: ${JC_LARK_APPLY_APP_ID}
    appSecret: ${JC_LARK_APPLY_APP_SECRET}
    appToken: ${JC_LARK_APPLY_APP_TOKEN}
    tableID: ${JC_LARK_APPLY_TABLE_ID}
  tgeHall:
    appID: ${JC_LARK_TGE_APP_ID}
    appSecret: ${JC_LARK_TGE_APP_SECRET}
    appToken: ${JC_LARK_TGE_APP_TOKEN}
    tableID: ${JC_LARK_TGE_TABLE_ID}

# 腾讯云 COS / CDN 凭据
tencent:
  secretId: ${JC_TENCENT_SECRET_ID}
  secretKey: ${JC_TENCENT_SECRET_KEY}
cos:
  bucket: ${JC_COS_BUCKET}
  region: ${JC_COS_REGION}
  host: ${JC_COS_HOST}
cdn:
  privateKey: ${JC_CDN_PRIVATE_KEY}

twitter:
  clientID: ${JC_TWITTER_CLIENT_ID}
  clientSecret: ${JC_TWITTER_CLIENT_SECRET}
  redirectURL: ${JC_TWITTER_REDIRECT_URL}
  # App-only Bearer Token (查置顶推文用) — Twitter Developer → Keys and tokens 页 Regenerate
  bearerToken: ${JC_TWITTER_BEARER_TOKEN}

reown:
  projectID: ${JC_REOWN_PROJECT_ID}

telegram:
  botToken: ${JC_TG_BOT_TOKEN}
  botUsername: ${JC_TG_BOT_USERNAME}
  # HMAC 密钥用来签 /签验 TG bind deep-link payload；必须跟 tgbot 的
  # JOINCARE_SECRET 完全一致，否则前端拿到的 tgBindLink 是错的 or
  # tgbot 收到后 VerifyBindPayload 失败 → 用户 /start 后不产生绑定
  bindSecret: ${JC_TG_BIND_SECRET}
  # 运维告警群 chat_id（supergroup -100 开头）；后端 ops.PostAlert 直推。
  # 留空 = 告警 no-op（静默丢弃，仅日志）
  opsChatID: ${JC_TG_OPS_CHAT_ID}

chain:
  # IDO 主合约链（project relayer：Create/Active/End 等后端代发操作）
  project:
    url: ${JC_PROJECT_CHAIN_RPC}
    chainID: ${JC_PROJECT_CHAIN_ID}
    private: ${JC_PROJECT_KEEPER_KEY}
    # Durable outbox signer；必须与 core relayer 使用不同地址，禁止回退或手工共用。
    jobPrivate: ${JC_PROJECT_JOB_KEY}
    contractAddress: ${JC_PROJECT_CONTRACT}
    v1:
      # Explicit false means this environment has never registered a legacy JCC IDO source.
      enabled: ${JC_PROJECT_V1_ENABLED_YAML}
    # 首次启动时从此区块（含）开始索引；不配置则从当前已确认链尖开始。
    startBlock: ${JC_PROJECT_START_BLOCK}
    confirmations: ${JC_PROJECT_CONFIRMATIONS}
    reconciliation:
      # Durable fixed-block audit task participant ceiling. Contract participant getter is still bulk;
      # values above 10000 are clamped by the service and require a paginated contract getter redesign.
      maxParticipants: ${JC_IDO_RECONCILIATION_MAX_PARTICIPANTS}
    # Fresh-proxy stablecoin IDO V2. This section is trusted backend configuration;
    # clients submit only USDT/USDC symbols and never token addresses or decimals.
    v2:
      contractAddress: ${JC_IDO_V2_CONTRACT}
      startBlock: ${JC_IDO_V2_START_BLOCK}
      implementationAddress: ${JC_IDO_V2_IMPLEMENTATION}
      implementationCodeHash: ${JC_IDO_V2_IMPLEMENTATION_CODE_HASH}
      operator: ${JC_IDO_V2_OPERATOR}
      feeReceiver: ${JC_IDO_V2_FEE_RECEIVER}
      successFeeRate: ${JC_IDO_V2_SUCCESS_FEE_RATE}
      paymentTokens:
        USDT:
          address: ${JC_IDO_V2_USDT_ADDRESS}
          decimals: ${JC_IDO_V2_USDT_DECIMALS}
        USDC:
          address: ${JC_IDO_V2_USDC_ADDRESS}
          decimals: ${JC_IDO_V2_USDC_DECIMALS}
  task:
    # backend initChainClient 读这些字段
    url: ${JC_CHAIN_RPC}
    chainID: ${JC_CHAIN_ID}
    private: ${JC_CHAIN_KEEPER_KEY}
    contractAddress: ${JC_CHECKIN_CONTRACT}
    # backend /platform/v1/settings 下发给前端的字段名
    checkinAddress: ${JC_CHECKIN_CONTRACT}
