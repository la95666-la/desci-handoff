# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址（vite proxy 将 /api/* 转发到后端 /admin/* — 见 vite.config.ts）
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务（JoinCare admin 直连真后端，关闭）
VITE_NITRO_MOCK=false

# JoinCare 后端 admin API 地址（WSL2 docker bridge IP；本地直连 backend 容器无需 DNAT）
VITE_JOINCARE_API_TARGET=http://172.18.0.4:13004

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
