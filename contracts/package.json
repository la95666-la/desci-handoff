{
  "name": "joincare-smartcontract",
  "version": "1.0.0",
  "description": "JoinCare IDO Platform Smart Contracts",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fair-launch-model": "node scripts/testFairLaunchBehavioralModel.js",
    "test:coverage": "hardhat coverage",
	"preflight:jc-target": "node scripts/requireJcTargetEnv.js",
	"deploy:testnet": "node scripts/requireJcTargetEnv.js 97 && hardhat run scripts/deploy.js --network jcTarget",
	"deploy:ido-v2:testnet": "node scripts/requireJcTargetEnv.js 97 && hardhat run scripts/deployIDOv2.js --network jcTarget",
	"configure:ido-v2-project-token:testnet": "node scripts/requireJcTargetEnv.js 97 && hardhat run scripts/configureIDOv2ProjectToken.js --network jcTarget",
    "deploy:test-project-token": "hardhat run scripts/deployTestProjectToken.js",
    "deploy:mock-payment-tokens": "hardhat run scripts/deployMockPaymentTokens.js",
	"deploy:mainnet": "node scripts/requireJcTargetEnv.js 56 && hardhat run scripts/deploy.js --network jcTarget",
	"deploy:ido-v2:mainnet": "node scripts/requireJcTargetEnv.js 56 && hardhat run scripts/deployIDOv2.js --network jcTarget",
	"upgrade:testnet": "node scripts/requireJcTargetEnv.js 97 && hardhat run scripts/upgrade.js --network jcTarget",
	"upgrade:mainnet": "node scripts/requireJcTargetEnv.js 56 && hardhat run scripts/upgrade.js --network jcTarget",
	"test:e2e:quick": "npm run preflight:jc-target && hardhat run scripts/testnet/runCompleteTest.js --network jcTarget",
	"test:e2e:full": "npm run preflight:jc-target && hardhat run scripts/testnet/runFullTest.js --network jcTarget",
	"test:e2e:ido-v2:local": "hardhat run scripts/testnet/runIDOv2Lifecycle.js --network localhost",
	"test:e2e:ido-v2:testnet": "node scripts/requireJcTargetEnv.js 97 && hardhat run scripts/testnet/runIDOv2Lifecycle.js --network jcTarget",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "generate:wallet": "node scripts/generateWallet.js",
    "validate:fair-launch:deployment": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/validateFairLaunchDeployment.js --network hardhat",
    "validate:fair-launch:upgrade": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/validateFairLaunchUpgrade.js --network hardhat",
    "validate:fair-launch:deployment:test-only": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/validateFairLaunchDeploymentTestOnly.js --network hardhat",
    "validate:fair-launch:upgrade:test-only": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/validateFairLaunchUpgradeTestOnly.js --network hardhat",
    "validate:fair-launch:freeze": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/checkFairLaunchProductionFreeze.js --network hardhat",
    "prepare:fair-launch:mainnet": "hardhat compile && node scripts/prepareFairLaunchMainnetDeployment.js",
    "prepare:fair-launch:timelocks": "hardhat compile && node scripts/prepareFairLaunchMainnetTimelocks.js",
    "prepare:fair-launch:payment-token-governance": "hardhat compile && node scripts/prepareFairLaunchPaymentTokenGovernance.js",
    "generate:fair-launch:event-manifest": "node scripts/local/generateFairLaunchEventManifest.js",
    "unavailable:fair-launch:signer-custody": "node scripts/local/createFairLaunchLocalE2EAuthority.js",
    "unavailable:fair-launch:signer-residue-cleanup": "node scripts/local/cleanupFairLaunchLocalE2ESignerCeremony.js",
    "unavailable:fair-launch:root-assembly": "node scripts/local/assembleFairLaunchLocalE2ETrustRoot.js",
    "unavailable:fair-launch:artifact-signing": "node scripts/local/signFairLaunchLocalE2EPayload.js",
    "unavailable:fair-launch:artifact-combining": "node scripts/local/combineFairLaunchLocalE2EArtifact.js",
    "fair-launch:local-e2e:frontend-admission": "node scripts/local/loadFairLaunchLocalE2EFrontendAdmission.js",
    "compile:fair-launch:local-e2e": "node node_modules/hardhat/internal/cli/bootstrap.js compile --config hardhat.local-e2e.config.js",
    "test:fair-launch:local-e2e": "node node_modules/hardhat/internal/cli/bootstrap.js test --config hardhat.local-e2e.config.js",
    "fair-launch:local-e2e:start": "node scripts/local/startFairLaunchLocalE2E.js",
    "fair-launch:local-e2e:deploy": "node scripts/local/deployFairLaunchLocalE2E.js",
    "fair-launch:local-e2e:status": "node scripts/local/fairLaunchLocalE2EControls.js",
    "fair-launch:local-e2e:stop": "node scripts/local/stopFairLaunchLocalE2E.js",
    "unavailable:fair-launch:persistent-lifecycle": "node scripts/local/runFairLaunchLocalE2ELifecycles.js"
  },
  "keywords": [
    "IDO",
    "blockchain",
    "solidity",
    "ethereum",
    "bsc"
  ],
  "author": "JoinCare Team",
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "engines": { "node": ">=22 <23" },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-toolbox": "4.0.0",
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/contracts-upgradeable": "5.1.0",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.28.6",
    "hardhat-gas-reporter": "1.0.10"
  }
}
