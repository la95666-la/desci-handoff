pragma solidity 0.8.22;
import {JoinCareFairLaunchV1Shared} from "./JoinCareFairLaunchV1Shared.sol";
import {JoinCareFairLaunchV1Logic as Logic} from "../libraries/JoinCareFairLaunchV1Logic.sol";
import {JoinCareFairLaunchV1Runtime as Runtime} from "../libraries/JoinCareFairLaunchV1Runtime.sol";
contract JoinCareFairLaunchV1FundsFacet is JoinCareFairLaunchV1Shared {
    function refund(uint256 id) external nonReentrant { _refund(id,msg.sender); }
    function refundFor(uint256 id,address user) external nonReentrant { if(user==address(0))revert InvalidAddress(); _refund(id,user); }
    function claim(uint256 id) external nonReentrant { _claim(id,msg.sender); }
    function claimFor(uint256 id,address user) external nonReentrant { if(user==address(0))revert InvalidAddress(); _claim(id,user); }
    function withdrawProjectProceeds(uint256 id) external nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage(); if($.payoutsPaused)revert PayoutsArePaused(); Project storage p=_project($,id); _status(p,ProjectStatus.Successful); if(msg.sender!=p.projectProceedsReceiver)revert UnauthorizedBeneficiary(msg.sender,p.projectProceedsReceiver); if(p.projectProceedsWithdrawn)revert AlreadyWithdrawn(); _checkPaymentRuntime($,p); uint256 fee=Logic.proportional(p.finalTotalRaised,p.platformFeeBps); uint256 amount=p.finalTotalRaised-fee;p.projectProceedsWithdrawn=true;$.reservedBalances[p.paymentToken]-=amount;_out($,p.paymentToken,p.projectProceedsReceiver,amount);emit FairLaunchProjectProceedsWithdrawn(id,p.paymentToken,p.projectProceedsReceiver,amount,fee); }
    function withdrawPlatformFee(uint256 id) external nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage(); if($.payoutsPaused)revert PayoutsArePaused(); Project storage p=_project($,id); _status(p,ProjectStatus.Successful); if(msg.sender!=p.platformFeeReceiver)revert UnauthorizedBeneficiary(msg.sender,p.platformFeeReceiver); if(p.platformFeeWithdrawn)revert AlreadyWithdrawn(); _checkPaymentRuntime($,p); uint256 amount=Logic.proportional(p.finalTotalRaised,p.platformFeeBps);p.platformFeeWithdrawn=true;$.reservedBalances[p.paymentToken]-=amount;_out($,p.paymentToken,p.platformFeeReceiver,amount);emit FairLaunchPlatformFeeWithdrawn(id,p.paymentToken,p.platformFeeReceiver,amount); }
    function withdrawFailedProjectTokens(uint256 id) external nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage(); if($.payoutsPaused)revert PayoutsArePaused(); Project storage p=_project($,id); if(p.status!=ProjectStatus.Failed&&p.status!=ProjectStatus.Cancelled)revert InvalidProjectStatus(ProjectStatus.Failed,p.status); if(msg.sender!=p.projectOwner)revert UnauthorizedProjectOwner(msg.sender);if(p.failedProjectTokensWithdrawn)revert AlreadyWithdrawn();_checkProjectRuntime($,p);uint256 amount=p.totalTokensDeposited;p.failedProjectTokensWithdrawn=true;$.reservedBalances[p.projectToken]-=amount;_out($,p.projectToken,p.projectOwner,amount);emit FairLaunchFailedProjectTokensWithdrawn(id,p.projectToken,p.projectOwner,amount); }
}
