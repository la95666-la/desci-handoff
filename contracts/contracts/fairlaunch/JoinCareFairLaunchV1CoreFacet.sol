pragma solidity 0.8.22;
import {JoinCareFairLaunchV1Shared} from "./JoinCareFairLaunchV1Shared.sol";
import {JoinCareFairLaunchV1Logic as Logic} from "../libraries/JoinCareFairLaunchV1Logic.sol";
import {JoinCareFairLaunchV1Runtime as Runtime} from "../libraries/JoinCareFairLaunchV1Runtime.sol";
contract JoinCareFairLaunchV1CoreFacet is JoinCareFairLaunchV1Shared {
    function createProject(CreateProjectParams calldata p, uint64[] calldata times, uint16[] calldata bps) external onlyOperator {
        FairLaunchStorage storage $ = _getFairLaunchStorage();
        _requireContributionsNotPaused($);
        Logic.validateCreateBasics(p.projectId,p.projectToken,p.paymentToken,p.projectOwner,p.projectProceedsReceiver,p.expectedPlatformFeeReceiver,p.saleTokenAmount,p.softCap,p.minContribution,p.maxContribution,p.startTime,p.endTime,block.timestamp);
        if (block.chainid == 56 && p.maxContribution == 0) revert InvalidProjectParameters();
        if ($.projects[p.projectId].projectId != 0) revert ProjectAlreadyExists(p.projectId);
        if (p.expectedPlatformFeeBps != $.platformFeeBps || p.expectedPlatformFeeReceiver != $.platformFeeReceiver) revert InvalidProjectParameters();
        _checkBeneficiary($, p.projectProceedsReceiver, p.projectProceedsReceiverAttestationDigest, p.projectProceedsReceiverAttestationVersion);
        _checkBeneficiary($, p.expectedPlatformFeeReceiver, p.expectedPlatformFeeReceiverAttestationDigest, p.expectedPlatformFeeReceiverAttestationVersion);
        ProjectTokenPolicy memory pt = $.projectTokenPolicies[p.projectToken];
        if (pt.policyVersion == 0) revert TokenNotConfigured(p.projectToken);
        if (!pt.enabledForNewProjects) revert TokenNotAllowed(p.projectToken);
        if (pt.emergencyBlocked) revert TokenEmergencyBlocked(p.projectToken);
        if (pt.policyDigest != p.expectedProjectTokenPolicyDigest || pt.policyVersion != p.expectedProjectTokenPolicyVersion) revert TokenPolicySnapshotChanged(p.projectToken, p.expectedProjectTokenPolicyDigest, p.expectedProjectTokenPolicyVersion, pt.policyDigest, pt.policyVersion);
        PaymentTokenAdmission memory admission = $.paymentTokenAdmissions[p.paymentToken];
        if (!admission.enabledForNewProjects) revert TokenNotAllowed(p.paymentToken);
        if (admission.emergencyBlocked) revert TokenEmergencyBlocked(p.paymentToken);
        PaymentTokenPolicyRevision memory pay = $.paymentTokenPolicyRevisions[p.paymentToken][admission.currentPolicyVersion];
        if (!pay.exists) revert PaymentTokenPolicyRevisionDoesNotExist(p.paymentToken, admission.currentPolicyVersion);
        if (pay.policyDigest != p.expectedPaymentTokenPolicyDigest || pay.policyVersion != p.expectedPaymentTokenPolicyVersion) revert TokenPolicySnapshotChanged(p.paymentToken, p.expectedPaymentTokenPolicyDigest, p.expectedPaymentTokenPolicyVersion, pay.policyDigest, pay.policyVersion);
        if (!$.releasePolicies[p.expectedReleasePolicyDigest]) revert ReleasePolicyNotEnabled(p.expectedReleasePolicyDigest);
        if ($.releasePolicyVersions[p.expectedReleasePolicyDigest] != p.expectedReleasePolicyVersion) revert ReleasePolicySnapshotMismatch(p.expectedReleasePolicyDigest, p.expectedReleasePolicyVersion, $.releasePolicyVersions[p.expectedReleasePolicyDigest]);
        Runtime.validateRuntime(p.projectToken, pt.runtimeCodeHash, pt.decimals);
        Runtime.validateRuntime(p.paymentToken, pay.runtimeCodeHash, pay.decimals);
        Logic.validateVesting(times,bps,p.endTime);
        for (uint256 i; i < times.length; ++i) { $.vestingTimes[p.projectId].push(times[i]); $.vestingBps[p.projectId].push(bps[i]); }
        Project storage project = $.projects[p.projectId];
        project.projectId=p.projectId; project.projectToken=p.projectToken; project.paymentToken=p.paymentToken; project.projectOwner=p.projectOwner; project.projectProceedsReceiver=p.projectProceedsReceiver;
        project.projectProceedsReceiverAttestationDigest=p.projectProceedsReceiverAttestationDigest; project.projectProceedsReceiverAttestationVersion=p.projectProceedsReceiverAttestationVersion;
        project.platformFeeReceiver=p.expectedPlatformFeeReceiver; project.platformFeeReceiverAttestationDigest=p.expectedPlatformFeeReceiverAttestationDigest; project.platformFeeReceiverAttestationVersion=p.expectedPlatformFeeReceiverAttestationVersion;
        project.projectTokenDecimals=pt.decimals; project.paymentTokenDecimals=pay.decimals; project.platformFeeBps=p.expectedPlatformFeeBps; project.status=ProjectStatus.Pending;
        project.projectTokenPolicyVersion=pt.policyVersion; project.paymentTokenPolicyVersion=pay.policyVersion; project.startTime=p.startTime; project.endTime=p.endTime; project.saleTokenAmount=p.saleTokenAmount; project.softCap=p.softCap; project.minContribution=p.minContribution; project.maxContribution=p.maxContribution;
        project.projectTokenCodeHash=pt.runtimeCodeHash; project.projectTokenPolicyDigest=pt.policyDigest; project.paymentTokenCodeHash=pay.runtimeCodeHash; project.paymentTokenPolicyDigest=pay.policyDigest; project.releasePolicyDigest=p.expectedReleasePolicyDigest; project.releasePolicyVersion=p.expectedReleasePolicyVersion;
        emit FairLaunchProjectCreated(p.projectId,p.projectToken,p.paymentToken,p.projectOwner,p.projectProceedsReceiver,p.projectProceedsReceiverAttestationDigest,p.projectProceedsReceiverAttestationVersion,p.expectedPlatformFeeReceiver,p.expectedPlatformFeeReceiverAttestationDigest,p.expectedPlatformFeeReceiverAttestationVersion,p.expectedPlatformFeeBps,p.saleTokenAmount,p.softCap,p.minContribution,p.maxContribution,p.startTime,p.endTime,pt.policyDigest,pt.policyVersion,pay.policyDigest,pay.policyVersion,p.expectedReleasePolicyDigest,p.expectedReleasePolicyVersion);
    }
    function depositProjectTokens(uint256 id, uint256 amount) external nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage(); _requireContributionsNotPaused($); Project storage p=_project($,id); _status(p,ProjectStatus.Pending); if(msg.sender!=p.projectOwner)revert UnauthorizedProjectOwner(msg.sender); Logic.validateDeposit(p.saleTokenAmount,p.totalTokensDeposited,amount); uint256 resulting=p.totalTokensDeposited+amount; _checkProjectRuntime($,p); _in(p.projectToken,amount); p.totalTokensDeposited=resulting; $.reservedBalances[p.projectToken]+=amount; _solvent($,p.projectToken); emit FairLaunchTokensDeposited(id,p.projectToken,msg.sender,amount,resulting); }
    function activateProject(uint256 id) external onlyOperator { FairLaunchStorage storage $=_getFairLaunchStorage(); _requireContributionsNotPaused($); Project storage p=_project($,id); _status(p,ProjectStatus.Pending); _checkProjectRuntime($,p); _checkPaymentRuntime($,p); if(p.totalTokensDeposited!=p.saleTokenAmount)revert InsufficientProjectTokens(p.saleTokenAmount,p.totalTokensDeposited); p.status=ProjectStatus.Active; emit FairLaunchActivated(id); }
    function contribute(uint256 id,uint256 amount) external nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage(); _requireContributionsNotPaused($); Project storage p=_project($,id); _status(p,ProjectStatus.Active); if(block.timestamp<p.startTime)revert ProjectNotStarted(p.startTime); if(block.timestamp>=p.endTime)revert ProjectEndedAlready(p.endTime); uint256 userTotal=$.positions[id][msg.sender].contributionAmount+amount; Logic.validateContribution(p.minContribution,p.maxContribution,amount,userTotal); uint256 resultingRaised=p.totalRaised+amount; if(p.maxContribution!=0&&resultingRaised>p.maxContribution)revert ExceedsMaxContribution(p.maxContribution,resultingRaised); _checkProjectRuntime($,p); _checkPaymentRuntime($,p); _in(p.paymentToken,amount); UserPosition storage pos=$.positions[id][msg.sender]; pos.contributionAmount=userTotal; p.totalRaised=resultingRaised; $.reservedBalances[p.paymentToken]+=amount; if(!$.hasParticipated[id][msg.sender]){$.hasParticipated[id][msg.sender]=true;p.participantCount++;} _solvent($,p.paymentToken); emit FairLaunchContribution(id,msg.sender,p.paymentToken,amount,userTotal,p.totalRaised); }
    function endProject(uint256 id) external { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); _status(p,ProjectStatus.Active); if(block.timestamp<p.endTime)revert ProjectNotEnded(p.endTime); p.finalTotalRaised=p.totalRaised; p.settlementBlockNumber=block.number; p.settlementAnchorBlockNumber=block.number-1; p.settlementAnchorBlockHash=blockhash(block.number-1); if(p.totalRaised<p.softCap){p.status=ProjectStatus.Failed;p.terminalReason=TerminalReason.SoftCapNotReached;}else if(!_projectRuntimeMatches($,p)){p.status=ProjectStatus.Failed;p.terminalReason=TerminalReason.TokenRuntimeInvalid;}else{p.status=ProjectStatus.SuccessfulPendingRelease;p.finalPriceNumerator=p.totalRaised;p.finalPriceDenominator=p.saleTokenAmount;} emit FairLaunchEnded(id,p.status,p.terminalReason,p.paymentToken,p.finalTotalRaised,p.finalPriceNumerator,p.finalPriceDenominator,p.settlementBlockNumber,p.settlementAnchorBlockNumber,p.settlementAnchorBlockHash); }
    function cancelProject(uint256 id,bytes32 reason,bytes32 evidence) external onlyOperator { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); ProjectStatus previous=p.status; if(previous!=ProjectStatus.Pending&&previous!=ProjectStatus.Active)revert InvalidProjectStatus(ProjectStatus.Pending,previous); if(block.timestamp>=p.endTime)revert CancellationWindowClosed(p.endTime); p.status=ProjectStatus.Cancelled;p.terminalReason=TerminalReason.CancelledByOperator; emit FairLaunchCancelled(id,previous,reason,evidence,msg.sender); }
}
