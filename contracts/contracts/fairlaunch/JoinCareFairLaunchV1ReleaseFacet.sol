pragma solidity 0.8.22;
import {JoinCareFairLaunchV1Shared} from "./JoinCareFairLaunchV1Shared.sol";
import {JoinCareFairLaunchV1Logic as Logic} from "../libraries/JoinCareFairLaunchV1Logic.sol";
import {JoinCareFairLaunchV1Runtime as Runtime} from "../libraries/JoinCareFairLaunchV1Runtime.sol";
contract JoinCareFairLaunchV1ReleaseFacet is JoinCareFairLaunchV1Shared {
    function releaseSuccessfulProject(uint256 id,uint256 blockNumber,uint256 anchorNumber,bytes32 anchorHash,bytes32 txHash,uint32 ordinal,bytes32 manifest) external onlyOperator { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); _status(p,ProjectStatus.SuccessfulPendingRelease); if(blockNumber!=p.settlementBlockNumber||anchorNumber!=p.settlementAnchorBlockNumber||anchorHash!=p.settlementAnchorBlockHash)revert SettlementAnchorMismatch(p.settlementAnchorBlockNumber,p.settlementAnchorBlockHash,anchorNumber,anchorHash); if(block.number<blockNumber+20)revert ReleaseConfirmationDepthNotReached(blockNumber+20,block.number); if(txHash==0||manifest==0)revert InvalidReleaseEvidence(); _checkProjectRuntime($,p); _checkPaymentRuntime($,p); if(!$.releasePolicies[p.releasePolicyDigest])revert ReleasePolicyNotEnabled(p.releasePolicyDigest); if($.releasePolicyVersions[p.releasePolicyDigest]!=p.releasePolicyVersion)revert ReleasePolicySnapshotMismatch(p.releasePolicyDigest,p.releasePolicyVersion,$.releasePolicyVersions[p.releasePolicyDigest]); p.settlementTxHash=txHash;p.settlementTxLogOrdinal=ordinal;p.releaseManifestDigest=manifest;p.status=ProjectStatus.Successful; emit FairLaunchSuccessfulReleased(id,blockNumber,msg.sender,anchorNumber,anchorHash,txHash,ordinal,manifest,p.releasePolicyDigest,p.releasePolicyVersion); }
    function failPendingReleaseForProjectTokenRuntimeMismatch(uint256 id) external { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); _status(p,ProjectStatus.SuccessfulPendingRelease); if(_projectRuntimeMatches($,p))revert ProjectTokenRuntimeStillMatches(); p.status=ProjectStatus.Failed;p.terminalReason=TerminalReason.TokenRuntimeInvalid; emit FairLaunchPendingReleaseInvalidated(id,p.terminalReason,GovernanceInvalidationClass.ProjectTokenNonObjectiveRisk,bytes32(0),bytes32(0),msg.sender); }
    function invalidatePendingRelease(uint256 id,GovernanceInvalidationClass c,bytes32 reason,bytes32 evidence) external onlyOwner { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); _status(p,ProjectStatus.SuccessfulPendingRelease); if(uint8(c)>uint8(GovernanceInvalidationClass.LegalOrComplianceHold))revert InvalidGovernanceInvalidationClass(c); p.status=ProjectStatus.Failed;p.terminalReason=TerminalReason.GovernanceInvalidation; emit FairLaunchPendingReleaseInvalidated(id,p.terminalReason,c,reason,evidence,msg.sender); }
    function invalidatePendingReleaseForPaymentToken(uint256 id,bytes32 reason,bytes32 evidence) external onlyOwner { FairLaunchStorage storage $=_getFairLaunchStorage(); Project storage p=_project($,id); _status(p,ProjectStatus.SuccessfulPendingRelease); PaymentTokenPolicyRevision memory r=$.paymentTokenPolicyRevisions[p.paymentToken][p.paymentTokenPolicyVersion]; bytes32 observed=Runtime.codeHash(p.paymentToken); bool blocked=$.paymentTokenAdmissions[p.paymentToken].emergencyBlocked; if(_paymentRuntimeMatches($,p))revert PaymentTokenNotInvalidatable(); p.status=ProjectStatus.Failed;p.terminalReason=TerminalReason.PaymentTokenGovernanceInvalidation; emit FairLaunchPaymentTokenInvalidated(id,p.paymentToken,msg.sender,p.paymentTokenCodeHash,observed,p.paymentTokenPolicyDigest,p.paymentTokenPolicyVersion,r.policyDigest,r.policyVersion,blocked,reason,evidence); }
}
