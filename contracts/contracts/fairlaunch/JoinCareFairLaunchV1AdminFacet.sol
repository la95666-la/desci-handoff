pragma solidity 0.8.22;
import {JoinCareFairLaunchV1Shared} from "./JoinCareFairLaunchV1Shared.sol";
import {JoinCareFairLaunchV1Logic as Logic} from "../libraries/JoinCareFairLaunchV1Logic.sol";
import {JoinCareFairLaunchV1Runtime as Runtime} from "../libraries/JoinCareFairLaunchV1Runtime.sol";
contract JoinCareFairLaunchV1AdminFacet is JoinCareFairLaunchV1Shared {
    function pauseContributions(bytes32 reason,bytes32 evidence) external onlyPauseGuardian { FairLaunchStorage storage $=_getFairLaunchStorage();$.contributionsPaused=true;emit FairLaunchContributionsPaused(msg.sender,reason,evidence); }
    function unpauseContributions(bytes32 op) external onlyUnpauseTimelock { FairLaunchStorage storage $=_getFairLaunchStorage();$.contributionsPaused=false;emit FairLaunchContributionsUnpaused(msg.sender,op); }
    function pausePayouts(bytes32 reason,bytes32 evidence) external onlyPauseGuardian { FairLaunchStorage storage $=_getFairLaunchStorage();$.payoutsPaused=true;emit FairLaunchPayoutsPaused(msg.sender,reason,evidence); }
    function unpausePayouts(bytes32 op) external onlyUnpauseTimelock { FairLaunchStorage storage $=_getFairLaunchStorage();$.payoutsPaused=false;emit FairLaunchPayoutsUnpaused(msg.sender,op); }
    function pauseClaims(uint64 until,bytes32 reason,bytes32 evidence) external onlyPauseGuardian { Logic.validateClaimsPause(until,uint64(block.timestamp),uint64(block.timestamp+7 days));FairLaunchStorage storage $=_getFairLaunchStorage();$.claimsPauseUntil=until;emit FairLaunchClaimsPaused(msg.sender,until,reason,evidence); }
    function unpauseClaims(bytes32 op) external onlyUnpauseTimelock { FairLaunchStorage storage $=_getFairLaunchStorage();$.claimsPauseUntil=0;emit FairLaunchClaimsUnpaused(msg.sender,op); }
    function setOperator(address v) external onlyOwner { if(v==address(0))revert InvalidAddress();FairLaunchStorage storage $=_getFairLaunchStorage();address old=$.operator;$.operator=v;emit FairLaunchOperatorUpdated(old,v); }
    function setPauseGuardian(address v) external onlyOwner { if(v==address(0))revert InvalidAddress();FairLaunchStorage storage $=_getFairLaunchStorage();address old=$.pauseGuardian;$.pauseGuardian=v;emit FairLaunchPauseGuardianUpdated(old,v); }
    function setUnpauseTimelock(address v) external onlyOwner { if(v==address(0))revert InvalidAddress();FairLaunchStorage storage $=_getFairLaunchStorage();address old=$.unpauseTimelock;$.unpauseTimelock=v;emit FairLaunchUnpauseTimelockUpdated(old,v); }
    function setTreasury(address v) external onlyOwner { if(v==address(0))revert InvalidAddress();FairLaunchStorage storage $=_getFairLaunchStorage();address old=$.treasury;$.treasury=v;emit FairLaunchTreasuryUpdated(old,v); }
    function setPlatformFee(uint16 bps,address receiver) external onlyOwner { if(receiver==address(0))revert InvalidAddress();if(bps>MAX_FEE_RATE)revert InvalidFeeBps(bps,MAX_FEE_RATE);FairLaunchStorage storage $=_getFairLaunchStorage();uint16 oldBps=$.platformFeeBps;address old=$.platformFeeReceiver;$.platformFeeBps=bps;$.platformFeeReceiver=receiver;emit FairLaunchPlatformFeeUpdated(oldBps,bps,old,receiver); }
    function registerPaymentTokenPolicyRevision(address token,PaymentTokenPolicyRevision calldata r) external onlyOwner { if(token==address(0))revert InvalidAddress();if(r.policyVersion==0||r.runtimeCodeHash==0||r.policyDigest==0)revert InvalidProjectParameters();if(r.decimals>77)revert InvalidTokenDecimals(r.decimals);FairLaunchStorage storage $=_getFairLaunchStorage();if($.paymentTokenPolicyRevisions[token][r.policyVersion].exists)revert PaymentTokenPolicyRevisionAlreadyExists(token,r.policyVersion);Runtime.validateRuntime(token,r.runtimeCodeHash,r.decimals);$.paymentTokenPolicyRevisions[token][r.policyVersion]=PaymentTokenPolicyRevision(true,r.decimals,r.policyVersion,r.runtimeCodeHash,r.policyDigest);emit FairLaunchPaymentTokenPolicyRevisionRegistered(token,r.policyVersion,r.decimals,r.runtimeCodeHash,r.policyDigest); }
    function setPaymentTokenAdmission(address token,uint32 version,bool enabled) external onlyOwner { FairLaunchStorage storage $=_getFairLaunchStorage();if(!$.paymentTokenPolicyRevisions[token][version].exists)revert PaymentTokenPolicyRevisionDoesNotExist(token,version);$.paymentTokenAdmissions[token].currentPolicyVersion=version;$.paymentTokenAdmissions[token].enabledForNewProjects=enabled;emit FairLaunchPaymentTokenAdmissionUpdated(token,version,enabled); }
    function setPaymentTokenEmergencyBlocked(address token,bool blocked) external onlyOwner { FairLaunchStorage storage $=_getFairLaunchStorage();if($.paymentTokenAdmissions[token].currentPolicyVersion==0)revert TokenNotConfigured(token);$.paymentTokenAdmissions[token].emergencyBlocked=blocked;emit FairLaunchPaymentTokenEmergencyBlockUpdated(token,blocked); }
    function configureProjectToken(address token,ProjectTokenPolicy calldata p) external onlyOwner { if(token==address(0))revert InvalidAddress();if(p.policyVersion==0||p.runtimeCodeHash==0||p.policyDigest==0)revert InvalidProjectParameters();if(p.decimals>77)revert InvalidTokenDecimals(p.decimals);Runtime.validateRuntime(token,p.runtimeCodeHash,p.decimals);FairLaunchStorage storage $=_getFairLaunchStorage();$.projectTokenPolicies[token]=p;emit FairLaunchProjectTokenConfigured(token,p.enabledForNewProjects,p.emergencyBlocked,p.decimals,p.policyVersion,p.runtimeCodeHash,p.policyDigest); }
    function configureBeneficiarySafe(address account,bool approved,bytes32 digest,uint32 version) external onlyOwner { if(account==address(0))revert InvalidAddress();if(approved&&(account.code.length==0||digest==0||version==0))revert BeneficiarySafeNotApproved(account);FairLaunchStorage storage $=_getFairLaunchStorage();$.approvedBeneficiarySafes[account]=approved;$.beneficiarySafeAttestations[account]=digest;$.beneficiarySafeAttestationVersions[account]=version;emit FairLaunchBeneficiarySafeConfigured(account,approved,digest,version); }
    function configureReleasePolicy(bytes32 digest,uint32 version,bool enabled) external onlyOwner { if(digest==0||version==0)revert InvalidProjectParameters();FairLaunchStorage storage $=_getFairLaunchStorage();$.releasePolicies[digest]=enabled;$.releasePolicyVersions[digest]=version;emit FairLaunchReleasePolicyConfigured(digest,version,enabled); }
    function recoverExcessTokens(address token,uint256 amount) external onlyOwner nonReentrant { FairLaunchStorage storage $=_getFairLaunchStorage();if($.payoutsPaused)revert PayoutsArePaused();uint256 balance=Runtime.balance(token,address(this));uint256 reserved=$.reservedBalances[token];_solvent($,token);uint256 recoverable=balance-reserved;if(amount==0||amount>recoverable)revert ExcessiveRecoveryRequested(token,recoverable,amount);_out($,token,$.treasury,amount);emit FairLaunchExcessTokensRecovered(token,$.treasury,amount); }
}
