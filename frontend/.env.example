# 环境配置示例
# 将此文件复制为 .env.local，然后根据需要修改

# 前端环境选择: local | test | prod
# - local: 本地开发
#   API: http://localhost:8080
#
# - test: 测试环境
#   API: (暂未配置)
#
# - prod: 线上环境
#   API: (暂未配置)
VITE_ENVIRONMENT=local

# Reown (原 WalletConnect) Cloud Project ID
# 注册：https://cloud.reown.com（免费）
# 不填则 WalletConnect 通道不可用（弹窗里 WC / 远端钱包变灰），
# 浏览器扩展钱包（MetaMask / OKX / Coinbase Extension 等）仍能正常连接
VITE_REOWN_PROJECT_ID=

# Fair Launch wallet submissions are disabled by default in every build.
# A LOCAL-ONLY test harness may generate a separate ignored env file containing ALL
# values below from one fresh Hardhat deployment. Never hand-maintain or commit them.
# VITE_FAIR_LAUNCH_TEST_MODE=local_test
# VITE_FAIR_LAUNCH_LOCAL_WALLET_SUBMISSION=false
# VITE_CHECKIN_CHAIN_ID=31337
# VITE_HARDHAT_RPC=http://127.0.0.1:8545
# VITE_FAIR_LAUNCH_LOCAL_RPC_URL=http://127.0.0.1:8545
# VITE_FAIR_LAUNCH_LOCAL_CHAIN_ID=31337
# VITE_FAIR_LAUNCH_LOCAL_PROJECT_ID=
# VITE_FAIR_LAUNCH_LOCAL_PROXY_ADDRESS=
# VITE_FAIR_LAUNCH_LOCAL_IMPLEMENTATION_ADDRESS=
# VITE_FAIR_LAUNCH_LOCAL_IMPLEMENTATION_CODE_HASH=
# VITE_FAIR_LAUNCH_LOCAL_PAYMENT_TOKEN_ADDRESS=
# VITE_FAIR_LAUNCH_LOCAL_PROJECT_TOKEN_ADDRESS=
# VITE_FAIR_LAUNCH_LOCAL_OBSERVATION_BLOCK_HASH=
# VITE_FAIR_LAUNCH_LOCAL_RUN_ID=
